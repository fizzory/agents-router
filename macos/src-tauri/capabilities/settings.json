{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "settings",
  "description": "Settings configuration, roles, accounts, sharing, activity, editor and workspace picker.",
  "windows": [
    "settings"
  ],
  "permissions": [
    "allow-get-snapshot",
    "allow-get-settings-target",
    "allow-show-setting-menu",
    "allow-show-pane-menu",
    "allow-copy-text",
    "allow-setup-roles",
    "allow-activity-undo-sync",
    "allow-config-show",
    "allow-config-set",
    "allow-config-unset",
    "allow-config-revert",
    "allow-roles-show",
    "allow-roles-config",
    "allow-accounts-list",
    "allow-accounts-check",
    "allow-accounts-add-check",
    "allow-accounts-toggle",
    "allow-accounts-login",
    "allow-accounts-add",
    "allow-share-list",
    "allow-share-status",
    "allow-share-kind",
    "allow-share-pick",
    "allow-activity-log",
    "allow-open-settings-file",
    "allow-choose-workspace",
    "allow-get-open-at-login",
    "allow-set-open-at-login",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-start-dragging"
  ]
}
