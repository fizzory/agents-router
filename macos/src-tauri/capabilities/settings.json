{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "settings",
  "description": "Only Settings config operations, editor, workspace picker, login toggle and event subscriptions.",
  "windows": [
    "settings"
  ],
  "permissions": [
    "allow-get-snapshot",
    "allow-get-settings-target",
    "allow-show-setting-menu",
    "allow-config-show",
    "allow-config-set",
    "allow-config-unset",
    "allow-config-revert",
    "allow-open-settings-file",
    "allow-choose-workspace",
    "allow-get-open-at-login",
    "allow-set-open-at-login",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-start-dragging"
  ]
}
