{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Agents Router",
  "version": "0.16.1",
  "identifier": "io.github.watcharagorn.agents-router",
  "build": { "frontendDist": "../ui" },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      { "label": "popover", "title": "Agents Router", "url": "index.html", "visible": false, "width": 360, "height": 400 },
      { "label": "settings", "title": "Agents Router Settings", "url": "index.html", "visible": false, "width": 760, "height": 560 }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self'; font-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; frame-src 'none'; form-action 'none'",
      "capabilities": ["popover", "settings"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": ["icons/icon.icns", "icons/icon.png"],
    "macOS": { "minimumSystemVersion": "14.0", "signingIdentity": "-" }
  }
}
